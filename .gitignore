# ==========================================
# KAIROS-HIMS Root .gitignore
# ==========================================

# Dependencies (All packages)
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Production Build Outputs
dist/
dist-ssr/
build/
backend/dist/
frontend/dist/
*.tsbuildinfo

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Uploaded Files & Clinical Evidence (Sensitive User Data)
uploads/
backend/uploads/
backend/uploads/evidence/
*.pdf
*.docx
*.xlsx

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS Metadata
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary Artifacts & Previews
.codex-artifacts/
.temp/
.tmp/


# Interim Evaluation Evidence (Local Examiner Proof Kit)
Interim_Evidence/
interim_evidence/

Evidence/
evidence/
